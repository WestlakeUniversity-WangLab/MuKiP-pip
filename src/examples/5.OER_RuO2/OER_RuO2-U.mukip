// This is an example for MuKiP-0.5.0
// reference: J. Phys. Chem. Lett., 16(35), 8986-8993
{
    "decimal_precision": 120,
    "convergence_precision": 100,
    "parameter": {
        "T": 298.15,
        "pH": 0
    },
    "species": {
        "H2O_g": {
            "not_virtual": false
        },
        "H2O_l": {
            "concentration": 1.0,
            "thermo": "VapourLiquid",
            "attributes": {
                "vapor_pressure": 0.035
            }
        },
        "H:+_aq": {
            "concentration": "10 ^ (-pH)"
        },
        "H2_g": {
            "concentration": 0.0
        },
        "O2_g": {
            "concentration": 0.0
        },
        "s": {
            "total": 1
        }
    },
    "reactions": {
        "0": {"equation": "H2O_l + * -> H:+_aq + ele + OH*"},
        "1": {"equation": "OH* -> O* + H:+_aq + ele"},
        "2": {"equation": "O* + H2O_l -> O|H2O*"},
        "3": {"equation": "O|H2O* + t-> O-OH2_t|s -> H|OOH_t|s"},
        "4": {"equation": "O|H2O* + b -> O-OH2_s|b -> OOH|H_s|b"},
        "5": {"equation": "H|OOH_t|s -> H:+_aq + ele + OOH* + t"},
        "6": {"equation": "OOH|H_s|b -> H:+_aq + ele + OOH* + b"},
        "7": {"equation": "OOH* -> O2_g + H:+_aq + ele + *"},
        "8": {"equation": "O* + t -> O-_t|s -> O_t|s"},
        "9": {"equation": "O_t|s + H2O_l -> O2_g + H_t + H:+_aq + ele + *"},
        "10": {"equation": "H_t -> H:+_aq + ele + t"},
        "11": {"equation": "O* + b -> O-_s|b -> O_s|b"},
        "12": {"equation": "O_s|b + H2O_l -> O2_g + H_b + H:+_aq + ele + *"},
        "13": {"equation": "H_b -> H:+_aq + ele + b"},
        "14": {"equation": "OH* + H2O_l + * -> OH|OH_2s + H:+_aq + ele"},
        "15": {"equation": "OH|OH_2s -> H:+_aq + ele + O|OH_2s"},
        "16": {"equation": "O|OH_2s -> H:+_aq + ele + O|O_2s"},
        "17": {"equation": "O|O_2s -> O-O_2s-> O2_2s"},
        "18": {"equation": "O2_2s -> O2_g + 2*"},
        "19": {"equation": "O|OH_2s -> O-OH_2s -> * + OOH*"},
        "20": {"equation": "2OH* <-> OH|OH_2s"},
        "21": {"equation": "O* + OH* <-> O|OH_2s"},
        "22": {"equation": "2O* <-> O|O_2s"}
    },
    "default_thermo": {
        "Gas": "IdealGas",
        "SurfaceSpecies": "Harmonic",
        "Aqua": "Frozen"
    },
    "mapper": {
        "class": "Mapper1D",
        "descriptors": {
            "U": [
                [
                    1.2,
                    2.0,
                    81
                ]
            ]
        }
    },
    "reader": [
        {
            "class": "EnergyTableReader",
            "input_file": "OER_RuO2.txt"
        }
    ],
    "scaler": {
        "class": "Scaler",
        "ele_energy_use_u": true

    },
    "solver": {
        "class": "SteadyStateSolver"
    },
    "guesser": [
        "OriginalDataGuess",
        "ODEGuesser",
        "AverageGuess",
        "ZeroGuess"
    ],
    "writer": [
        {
            "class": "CSV1DMultiWriter",
            "expressions": {
                "log(TOF[Total])": "log(tof[O2_g])",
                "log(TOF[AEMa])": "log(r[3])",
                "log(TOF[AEMb])": "log(r[4])",
                "log(TOF[LOMa])": "log(r[8])",
                "log(TOF[LOMb])": "log(r[11])",
                "log(TOF[OPMa])": "log(r[17])",
                "log(TOF[OPMb])": "log(r[19])"
            },
            "output_file": "Mechanisms-U.csv"
        }
    ]
}